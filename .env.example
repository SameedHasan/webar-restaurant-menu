# Supabase (optional for Phase 1 — mock data works without these)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set to false once Supabase is configured (enables real auth + DB for admin)
USE_MOCK_DATA=true

# Demo admin works at /admin/login when USE_MOCK_DATA=true (no credentials needed)

# App URL (used for QR code generation in Phase 3)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (optional — Phase 3+)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# AI 3D Generation (Phase 4)
# Required when USE_MOCK_DATA=false. Demo mode simulates generation without a key.
# MESHY_API_KEY=msy_...
